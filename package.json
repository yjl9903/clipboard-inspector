{
  "name": "clipboard-inspector",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write src/**/*.{ts,vue} --ignore-path .gitignore",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json --skipLibCheck && tsc --noEmit -p tsconfig.node.json --skipLibCheck"
  },
  "dependencies": {
    "ace-builds": "^1.45.2",
    "diffable-html": "^6.0.1",
    "html-format": "^1.1.7",
    "vue": "^3.5.45",
    "vue3-ace-editor": "^2.2.4"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.30",
    "@iconify-json/devicon": "^1.2.78",
    "@onekuma/preset.css": "^0.1.11",
    "@types/diffable-html": "^5.0.2",
    "@types/node": "^26.6.6",
    "@unocss/reset": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "unocss": "^66.12.0",
    "unplugin-analytics": "^0.0.13",
    "unplugin-auto-import": "21.1.0",
    "unplugin-info": "^1.3.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
